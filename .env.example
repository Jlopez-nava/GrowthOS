# Optional public browser configuration; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Sites runtime variables. Never prefix with NEXT_PUBLIC_ or commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_APP_ORIGIN=
GOOGLE_OWNER_EMAIL=
# 32 random bytes encoded as 64 lowercase hexadecimal characters.
CONNECTION_ENCRYPTION_KEY=

# Owner-selected reporting targets for the Zapier integration (server only).
ZAPIER_GA4_ACCOUNT_ID=
ZAPIER_GA4_PROPERTY_ID=
ZAPIER_GA4_PROPERTY_NAME=
ZAPIER_ADS_MANAGER_ID=
ZAPIER_ADS_CUSTOMER_ID=
# The owner enters their Zapier token in Connections; it is stored encrypted in R2.

# Unique to each independent company deployment. Never reuse across clones.
COMPANY_ID=
